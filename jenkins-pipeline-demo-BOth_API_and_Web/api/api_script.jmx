                  <stringProp name="Argument.value">{&#xd;
  &quot;name&quot;: &quot;User-${__RandomString(8,ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz,)}&quot;,&#xd;
  &quot;gender&quot;: &quot;${dp_gender}&quot;,&#xd;
  &quot;email&quot;: &quot;user${__RandomString(6,abcdefghijklmnopqrstuvwxyz0123456789,)}@15ce.com&quot;,&#xd;
