pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Validate Files') {
            steps {
                bat '''
                echo Checking API file...
                dir api

                echo Checking Web file...
                dir web
                '''
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                mkdir report\\final
                '''
            }
        }

        // TRUE PARALLEL EXECUTION (ONLY RUN TESTS)
        stage('Run API + Web Tests') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t api/api_script.jmx ^
                        -l results\\api.jtl
                        """
                    }
                }

                stage('Web Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t web/SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl
                        """
                    }
                }
            }
        }

        stage('Generate Reports') {
            steps {
                bat '''
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                '''
            }
        }

        stage('Final Report') {
            steps {
                bat '''
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\final
                '''
            }
        }
    }

    post {

        always {
            publishHTML (target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report\\final',
                reportFiles: 'index.html',
                reportName: 'JMeter Final Report'
            ])
        }

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✔ Jenkins SUCCESS - API + Web Test",
                body: """
Hi,

Your Jenkins pipeline executed successfully.

✔ API Test Completed  
✔ Web Test Completed  
✔ Reports Generated  

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}

Regards,
Jenkins Automation
"""
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins FAILED - JMeter Test",
                body: """
Hi,

Your Jenkins pipeline FAILED.

Please check logs.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}

Regards,
Jenkins
"""
            )
        }
    }
}
