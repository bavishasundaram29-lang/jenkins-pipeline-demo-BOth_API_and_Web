pipeline {
    agent any

    environment {
        WORKSPACE_DIR = "${env.WORKSPACE}"
        REPORT_DIR = "${WORKSPACE_DIR}/report"
        WEB_REPORT_DIR = "${REPORT_DIR}/web"
        API_REPORT_DIR = "${REPORT_DIR}/api"
        AGGREGATE_FILE = "${REPORT_DIR}/dashboard/aggregate-report.html"
        ZIP_OUTPUT = "${REPORT_DIR}/zips"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo.git', branch: 'main'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat 'if exist report rmdir /s /q report'
            }
        }

        stage('Create Directories') {
            steps {
                bat """
                mkdir ${WEB_REPORT_DIR}
                mkdir ${API_REPORT_DIR}
                mkdir ${REPORT_DIR}\\dashboard
                mkdir ${ZIP_OUTPUT}
                """
            }
        }

        stage('Build Web Report') {
            steps {
                bat """
                echo Generating Web Report...
                mkdir ${WEB_REPORT_DIR}
                echo Web Report Generated > ${WEB_REPORT_DIR}\\web-report.html
                """
            }
        }

        stage('Build API Report') {
            steps {
                bat """
                echo Generating API Report...
                mkdir ${API_REPORT_DIR}
                echo API Report Generated > ${API_REPORT_DIR}\\api-report.html
                """
            }
        }

        stage('Aggregate Dashboard') {
            steps {
                bat """
                echo <html><body><h1>Test Dashboard</h1> > ${AGGREGATE_FILE}
                echo <p>Web Report: web-report.html</p> >> ${AGGREGATE_FILE}
                echo <p>API Report: api-report.html</p> >> ${AGGREGATE_FILE}
                echo </body></html> >> ${AGGREGATE_FILE}
                """
            }
        }

        stage('Zip Reports') {
            steps {
                bat """
                powershell Compress-Archive -Path ${WEB_REPORT_DIR}\\* -DestinationPath ${ZIP_OUTPUT}\\web-report.zip -Force
                powershell Compress-Archive -Path ${API_REPORT_DIR}\\* -DestinationPath ${ZIP_OUTPUT}\\api-report.zip -Force
                """
            }
        }
    }

    post {

        success {
            emailext (
                subject: "Jenkins Build SUCCESS - Web + API Reports",
                body: """
                Build Successful 🎉

                Reports Generated:
                - Web Report: ${WEB_REPORT_DIR}
                - API Report: ${API_REPORT_DIR}
                - Dashboard: ${AGGREGATE_FILE}

                Zipped Reports Available in:
                ${ZIP_OUTPUT}

                Check Jenkins workspace for full details.
                """,
                to: "your-email@gmail.com"
            )
        }

        failure {
            emailext (
                subject: "Jenkins Build FAILED - Web + API Reports",
                body: "Build Failed. Please check Jenkins logs.",
                to: "your-email@gmail.com"
            )
        }

        always {
            archiveArtifacts artifacts: 'report/**', fingerprint: true
        }
    }
}
