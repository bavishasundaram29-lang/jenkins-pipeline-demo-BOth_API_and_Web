pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Verify Files') {
            steps {
                bat '''
                echo Current Workspace:
                cd

                echo ================= API Folder =================
                dir api

                echo ================= WEB Folder =================
                dir web
                '''
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                echo Cleaning old folders...

                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                '''
            }
        }

        stage('Run API + WEB Tests in Parallel') {

            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        echo Running API Test...

                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t api\\api_script.jmx ^
                        -l results\\api.jtl ^
                        -e -o report\\api ^
                        -Jjmeter.save.saveservice.output_format=csv
                        """
                    }
                }

                stage('WEB Test') {
                    steps {
                        bat """
                        echo Running WEB Test...

                        dir web

                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t web\\SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl ^
                        -e -o report\\web ^
                        -Jjmeter.save.saveservice.output_format=csv ^
                        -Jjmeter.save.saveservice.assertion_results=none ^
                        -Jjmeter.save.saveservice.response_data=false
                        """
                    }
                }
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                echo ================= RESULTS =================
                dir results

                echo ================= API REPORT =================
                dir report\\api

                echo ================= WEB REPORT =================
                dir report\\web

                if exist results\\api.jtl (
                    echo API JTL Generated Successfully
                ) else (
                    echo API JTL Missing
                )

                if exist results\\web.jtl (
                    echo WEB JTL Generated Successfully
                ) else (
                    echo WEB JTL Missing
                )

                if exist report\\web\\index.html (
                    echo WEB HTML Report Generated Successfully
                ) else (
                    echo WEB HTML Report Missing
                )
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: 'report/**', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',
                subject: "Jenkins Build Report - Build #${env.BUILD_NUMBER}",
                body: """
Build Status: ${currentBuild.currentResult}

✔ API Test Executed
✔ WEB Test Executed
✔ API HTML Report Generated
✔ WEB HTML Report Generated

Check reports in Jenkins UI.
                """,
                attachmentsPattern: 'report/**'
            )
        }
    }
}
