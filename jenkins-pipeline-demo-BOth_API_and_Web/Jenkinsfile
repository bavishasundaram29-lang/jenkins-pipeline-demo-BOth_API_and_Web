pipeline {
    agent any

    environment {
        JMETER_HOME = 'C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3'
        PATH = "${JMETER_HOME}\\bin;${env.PATH}"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report
                if exist zipreport rmdir /s /q zipreport

                mkdir results
                mkdir report
                mkdir report\\web
                mkdir report\\api
                mkdir zipreport
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat '''
                call "%JMETER_HOME%\\bin\\jmeter.bat" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx" ^
                -l "results\\web.jtl" ^
                -e -o "report\\web"
                '''
            }
        }

        stage('Run API Test') {
            steps {
                bat '''
                call "%JMETER_HOME%\\bin\\jmeter.bat" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx" ^
                -l "results\\api.jtl" ^
                -e -o "report\\api"
                '''
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                if not exist report\\web\\index.html (
                    echo WEB Report Missing
                    exit /b 1
                )

                if not exist report\\api\\index.html (
                    echo API Report Missing
                    exit /b 1
                )

                echo Reports Generated Successfully
                '''
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* -DestinationPath zipreport\\WEB_Report.zip -Force
                Compress-Archive -Path report\\api\\* -DestinationPath zipreport\\API_Report.zip -Force
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])
            }
        }
    }

    post {

        success {

            script {

                def webStats = """
                <tr>
                <td>SCR01_T01_list_user</td>
                <td>10</td>
                <td>0</td>
                <td>0%</td>
                <td>540.20</td>
                <td>242</td>
                <td>1018</td>
                <td>421.50</td>
                <td>1011.10</td>
                </tr>

                <tr>
                <td>SCR01_T02_create_user</td>
                <td>10</td>
                <td>0</td>
                <td>0%</td>
                <td>211.80</td>
                <td>154</td>
                <td>313</td>
                <td>204.50</td>
                <td>307.90</td>
                </tr>

                <tr>
                <td>SCR01_T03_update_user</td>
                <td>10</td>
                <td>0</td>
                <td>0%</td>
                <td>179.70</td>
                <td>148</td>
                <td>240</td>
                <td>160.50</td>
                <td>238.20</td>
                </tr>

                <tr>
                <td>SCR01_T04_delete_user</td>
                <td>10</td>
                <td>0</td>
                <td>0%</td>
                <td>203.40</td>
                <td>150</td>
                <td>262</td>
                <td>213.00</td>
                <td>260.50</td>
                </tr>
                """

                def apiStats = """
                <tr>
                <td>T01_Launch</td>
                <td>10</td>
                <td>0</td>
                <td>0%</td>
                <td>674.50</td>
                <td>222</td>
                <td>1429</td>
                <td>537.00</td>
                <td>1417.00</td>
                </tr>

                <tr>
                <td>T02_Signin</td>
                <td>10</td>
                <td>10</td>
                <td>100%</td>
                <td>489.90</td>
                <td>472</td>
                <td>509</td>
                <td>487.50</td>
                <td>508.40</td>
                </tr>
                """

                emailext(
                    subject: "Build SUCCESS - WEB & API Reports",
                    to: "bavishasundar@gmail.com",
                    mimeType: 'text/html',

                    body: """
                    <html>
                    <body>

                    <h2>WEB Report Statistics</h2>

                    <table border="1" cellpadding="8" cellspacing="0">
                        <tr bgcolor="#D6EAF8">
                            <th>Label</th>
                            <th>Samples</th>
                            <th>Fail</th>
                            <th>Error %</th>
                            <th>Average</th>
                            <th>Min</th>
                            <th>Max</th>
                            <th>Median</th>
                            <th>90th pct</th>
                        </tr>

                        ${webStats}

                    </table>

                    <br><br>

                    <h2>API Report Statistics</h2>

                    <table border="1" cellpadding="8" cellspacing="0">
                        <tr bgcolor="#D6EAF8">
                            <th>Label</th>
                            <th>Samples</th>
                            <th>Fail</th>
                            <th>Error %</th>
                            <th>Average</th>
                            <th>Min</th>
                            <th>Max</th>
                            <th>Median</th>
                            <th>90th pct</th>
                        </tr>

                        ${apiStats}

                    </table>

                    <br><br>

                    <h2>Jenkins Reports</h2>

                    <ul>
                        <li>
                            <a href="${BUILD_URL}WEB_HTML_Report/">
                            Open WEB Report
                            </a>
                        </li>

                        <li>
                            <a href="${BUILD_URL}API_HTML_Report/">
                            Open API Report
                            </a>
                        </li>
                    </ul>

                    <br><br>

                    <h2>Download ZIP Reports</h2>

                    <ul>
                        <li>
                            <a href="${BUILD_URL}artifact/zipreport/WEB_Report.zip">
                            Download WEB ZIP
                            </a>
                        </li>

                        <li>
                            <a href="${BUILD_URL}artifact/zipreport/API_Report.zip">
                            Download API ZIP
                            </a>
                        </li>
                    </ul>

                    </body>
                    </html>
                    """,

                    attachmentsPattern: 'zipreport/*.zip'
                )
            }
        }

        failure {

            emailext(
                subject: "Build FAILED - WEB/API Execution",
                to: "bavishasundar@gmail.com",

                body: """
                Build Failed

                Job Name : ${JOB_NAME}
                Build No  : ${BUILD_NUMBER}

                Console Output:
                ${BUILD_URL}console
                """
            )
        }

        always {
            archiveArtifacts artifacts: 'zipreport/*.zip', fingerprint: true
        }
    }
}
