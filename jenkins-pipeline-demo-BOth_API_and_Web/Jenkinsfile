pipeline {

    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                echo Cleaning Workspace...

                if exist results rmdir /s /q results
                if exist report rmdir /s /q report
                if exist zipreport rmdir /s /q zipreport

                mkdir results

                mkdir report
                mkdir report\\web
                mkdir report\\api

                mkdir report\\web_aggregate
                mkdir report\\api_aggregate

                mkdir zipreport
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat '''
                echo Running WEB Test...

                "%JMETER_HOME%\\bin\\jmeter.bat" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx" ^
                -l "results\\web.jtl" ^
                -e -o "report\\web"
                '''
            }
        }

        stage('Run API Test') {
            steps {
                bat '''
                echo Running API Test...

                "%JMETER_HOME%\\bin\\jmeter.bat" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx" ^
                -l "results\\api.jtl" ^
                -e -o "report\\api"
                '''
            }
        }

        stage('Generate WEB Aggregate Report') {
            steps {
                bat '''
                echo Generating WEB Aggregate Report...

                "%JMETER_HOME%\\bin\\jmeter.bat" -g "results\\web.jtl" ^
                -o "report\\web_aggregate"
                '''
            }
        }

        stage('Generate API Aggregate Report') {
            steps {
                bat '''
                echo Generating API Aggregate Report...

                "%JMETER_HOME%\\bin\\jmeter.bat" -g "results\\api.jtl" ^
                -o "report\\api_aggregate"
                '''
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                echo ================= WEB REPORT =================
                dir report\\web

                echo ================= API REPORT =================
                dir report\\api

                echo ================= WEB AGGREGATE REPORT =================
                dir report\\web_aggregate

                echo ================= API AGGREGATE REPORT =================
                dir report\\api_aggregate
                '''
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* `
                -DestinationPath zipreport\\WEB_Report.zip -Force

                Compress-Archive -Path report\\api\\* `
                -DestinationPath zipreport\\API_Report.zip -Force

                Compress-Archive -Path report\\web_aggregate\\* `
                -DestinationPath zipreport\\WEB_Aggregate_Report.zip -Force

                Compress-Archive -Path report\\api_aggregate\\* `
                -DestinationPath zipreport\\API_Aggregate_Report.zip -Force
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web_aggregate',
                    reportFiles: 'index.html',
                    reportName: 'WEB_Aggregate_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api_aggregate',
                    reportFiles: 'index.html',
                    reportName: 'API_Aggregate_Report'
                ])
            }
        }
    }

    post {

        always {
            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip',
            fingerprint: true
        }

        success {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB + API Reports SUCCESS - Build #${env.BUILD_NUMBER}",

                mimeType: 'text/html',

                body: """
                <html>
                <body>

                <h2>JMeter Execution Reports</h2>

                <table border="1" cellpadding="10" cellspacing="0">
                    <tr>
                        <th>Report Type</th>
                        <th>Status</th>
                        <th>Jenkins URL</th>
                    </tr>

                    <tr>
                        <td>WEB Report</td>
                        <td>SUCCESS</td>
                        <td>
                            <a href="${env.BUILD_URL}WEB_HTML_Report/">
                            Open WEB Report
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>API Report</td>
                        <td>SUCCESS</td>
                        <td>
                            <a href="${env.BUILD_URL}API_HTML_Report/">
                            Open API Report
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>WEB Aggregate Report</td>
                        <td>SUCCESS</td>
                        <td>
                            <a href="${env.BUILD_URL}WEB_Aggregate_Report/">
                            Open WEB Aggregate Report
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td>API Aggregate Report</td>
                        <td>SUCCESS</td>
                        <td>
                            <a href="${env.BUILD_URL}API_Aggregate_Report/">
                            Open API Aggregate Report
                            </a>
                        </td>
                    </tr>

                </table>

                <br><br>

                <h2>Download ZIP Reports</h2>

                <ul>

                    <li>
                        <a href="${env.BUILD_URL}artifact/zipreport/WEB_Report.zip">
                        Download WEB ZIP
                        </a>
                    </li>

                    <li>
                        <a href="${env.BUILD_URL}artifact/zipreport/API_Report.zip">
                        Download API ZIP
                        </a>
                    </li>

                    <li>
                        <a href="${env.BUILD_URL}artifact/zipreport/WEB_Aggregate_Report.zip">
                        Download WEB Aggregate ZIP
                        </a>
                    </li>

                    <li>
                        <a href="${env.BUILD_URL}artifact/zipreport/API_Aggregate_Report.zip">
                        Download API Aggregate ZIP
                        </a>
                    </li>

                </ul>

                <br>

                <b>Job Name:</b> ${env.JOB_NAME}<br>
                <b>Build Number:</b> ${env.BUILD_NUMBER}

                </body>
                </html>
                """,

                attachmentsPattern: 'zipreport/*.zip'
            )
        }

        failure {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "JMeter Reports FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
                Build Failed

                Check Console:
                ${env.BUILD_URL}console
                """
            )
        }
    }
}
