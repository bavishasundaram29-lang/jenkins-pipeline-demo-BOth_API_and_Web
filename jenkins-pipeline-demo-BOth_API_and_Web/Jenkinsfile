pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Verify Workspace') {
            steps {
                bat '''
                echo ================= WORKSPACE =================
                cd

                echo ================= ROOT FILES =================
                dir

                echo ================= API FILES =================
                dir api

                echo ================= WEB FILES =================
                dir web
                '''
            }
        }

        stage('Clean Old Reports') {
            steps {
                bat '''
                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                '''
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                echo Running API Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t api\\api_script.jmx ^
                -l results\\api.jtl

                echo API Test Completed
                """
            }
        }

        stage('Run WEB Test') {
            steps {
                bat """
                echo Running WEB Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl

                echo WEB Test Completed
                """
            }
        }

        stage('Check Result Files') {
            steps {
                bat '''
                echo ================= RESULTS =================
                dir results

                if exist results\\api.jtl (
                    echo API JTL Generated
                ) else (
                    echo API JTL NOT Generated
                )

                if exist results\\web.jtl (
                    echo WEB JTL Generated
                ) else (
                    echo WEB JTL NOT Generated
                )
                '''
            }
        }

        stage('Generate API Report') {
            steps {
                bat """
                echo Generating API HTML Report...

                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api
                """
            }
        }

        stage('Generate WEB Report') {
            steps {
                bat """
                echo Generating WEB HTML Report...

                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                """
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                echo ================= API REPORT =================
                dir report\\api

                echo ================= WEB REPORT =================
                dir report\\web
                '''
            }
        }

        stage('Publish Reports') {
            steps {

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])
            }
        }
    }

    post {
        always {

            archiveArtifacts artifacts: 'results/*.jtl,report/**', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',
                subject: "Jenkins Build #${env.BUILD_NUMBER}",
                body: """
Build Status: ${currentBuild.currentResult}

Check Jenkins HTML Reports section.
                """,
                attachmentsPattern: 'report/**'
            )
        }
    }
}
