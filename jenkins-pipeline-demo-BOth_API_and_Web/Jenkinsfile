pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
        JMETER = "${JMETER_HOME}\\bin\\jmeter.bat"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report
                if exist zipreport rmdir /s /q zipreport

                mkdir results
                mkdir report
                mkdir report\\web
                mkdir report\\api
                mkdir report\\web-aggregate
                mkdir report\\api-aggregate
                mkdir zipreport
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat '''
                "%JMETER%" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx" ^
                -l "results\\web.jtl" ^
                -e -o "report\\web"
                '''
            }
        }

        stage('Run API Test') {
            steps {
                bat '''
                "%JMETER%" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx" ^
                -l "results\\api.jtl" ^
                -e -o "report\\api"
                '''
            }
        }

        stage('Generate WEB Aggregate Report') {
            steps {
                bat '''
                "%JMETER%" -g "results\\web.jtl" -o "report\\web-aggregate"
                '''
            }
        }

        stage('Generate API Aggregate Report') {
            steps {
                bat '''
                "%JMETER%" -g "results\\api.jtl" -o "report\\api-aggregate"
                '''
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* -DestinationPath zipreport\\WEB_Report.zip -Force
                Compress-Archive -Path report\\api\\* -DestinationPath zipreport\\API_Report.zip -Force
                Compress-Archive -Path report\\web-aggregate\\* -DestinationPath zipreport\\WEB_Aggregate_Report.zip -Force
                Compress-Archive -Path report\\api-aggregate\\* -DestinationPath zipreport\\API_Aggregate_Report.zip -Force
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB HTML Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web-aggregate',
                    reportFiles: 'index.html',
                    reportName: 'WEB Aggregate Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api-aggregate',
                    reportFiles: 'index.html',
                    reportName: 'API Aggregate Report'
                ])
            }
        }
    }

    post {

        always {

            script {

                def webStats = readJSON file: 'report/web-aggregate/statistics.json'
                def apiStats = readJSON file: 'report/api-aggregate/statistics.json'

                def webRows = ""
                def apiRows = ""

                webStats.each { key, value ->
                    if (key != 'Total') {
                        webRows += """
                        <tr>
                            <td>${key}</td>
                            <td>${value.sampleCount}</td>
                            <td>${value.errorCount}</td>
                            <td>${String.format("%.2f", value.errorPct)}%</td>
                            <td>${String.format("%.2f", value.meanResTime)}</td>
                            <td>${value.minResTime}</td>
                            <td>${value.maxResTime}</td>
                            <td>${String.format("%.2f", value.medianResTime)}</td>
                            <td>${String.format("%.2f", value.pct1ResTime)}</td>
                        </tr>
                        """
                    }
                }

                apiStats.each { key, value ->
                    if (key != 'Total') {
                        apiRows += """
                        <tr>
                            <td>${key}</td>
                            <td>${value.sampleCount}</td>
                            <td>${value.errorCount}</td>
                            <td>${String.format("%.2f", value.errorPct)}%</td>
                            <td>${String.format("%.2f", value.meanResTime)}</td>
                            <td>${value.minResTime}</td>
                            <td>${value.maxResTime}</td>
                            <td>${String.format("%.2f", value.medianResTime)}</td>
                            <td>${String.format("%.2f", value.pct1ResTime)}</td>
                        </tr>
                        """
                    }
                }

                emailext(
                    subject: "Jenkins Build Report - ${currentBuild.currentResult}",
                    mimeType: 'text/html',
                    to: 'bavishasundar@gmail.com',

                    body: """
                    <html>
                    <body>

                    <h2>Build Status : ${currentBuild.currentResult}</h2>

                    <h2>WEB Aggregate Report</h2>

                    <table border="1" cellpadding="5" cellspacing="0">
                        <tr>
                            <th>Label</th>
                            <th>Samples</th>
                            <th>Fail</th>
                            <th>Error %</th>
                            <th>Average</th>
                            <th>Min</th>
                            <th>Max</th>
                            <th>Median</th>
                            <th>90th pct</th>
                        </tr>

                        ${webRows}

                    </table>

                    <br><br>

                    <h2>API Aggregate Report</h2>

                    <table border="1" cellpadding="5" cellspacing="0">
                        <tr>
                            <th>Label</th>
                            <th>Samples</th>
                            <th>Fail</th>
                            <th>Error %</th>
                            <th>Average</th>
                            <th>Min</th>
                            <th>Max</th>
                            <th>Median</th>
                            <th>90th pct</th>
                        </tr>

                        ${apiRows}

                    </table>

                    <br><br>

                    <h3>Reports Attached:</h3>

                    <ul>
                        <li>WEB_Report.zip</li>
                        <li>API_Report.zip</li>
                        <li>WEB_Aggregate_Report.zip</li>
                        <li>API_Aggregate_Report.zip</li>
                    </ul>

                    </body>
                    </html>
                    """,

                    attachmentsPattern: 'zipreport/*.zip'
                )
            }

            archiveArtifacts artifacts: 'report/**/*, zipreport/*.zip', fingerprint: true

        }
    }
}
