pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report

                mkdir results

                mkdir report
                mkdir report\\api
                mkdir report\\web
                '''
            }
        }

        stage('Run API and WEB Tests Parallel') {

            parallel {

                stage('API Test') {
                    steps {

                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx ^
                        -l results\\api_results.jtl ^
                        -e -o report\\api
                        """
                    }
                }

                stage('WEB Test') {
                    steps {

                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx ^
                        -l results\\web_results.jtl ^
                        -e -o report\\web
                        """
                    }
                }
            }
        }
    }

    post {

        always {

            // Archive all reports
            archiveArtifacts artifacts: 'results/**, report/**', fingerprint: true

            // Publish API Report
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report/api',
                reportFiles: 'index.html',
                reportName: 'API Report'
            ])

            // Publish WEB Report
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report/web',
                reportFiles: 'index.html',
                reportName: 'WEB Report'
            ])
        }

        success {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "✔ Jenkins Build SUCCESS - API & WEB Reports",

                body: """
Build SUCCESS

✔ API Test Executed
✔ WEB Test Executed

Separate reports generated successfully.

Available Reports:
1. API Report
2. WEB Report

Reports available in:
- Jenkins UI
- Jenkins Workspace
- Email Attachments

Job Name  : ${env.JOB_NAME}
Build No  : ${env.BUILD_NUMBER}
Build URL : ${env.BUILD_URL}
""",

                attachmentsPattern: '''
report/api/**,
report/web/**
'''
            )
        }

        failure {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "❌ Jenkins Build FAILED",

                body: """
Build FAILED

Check Jenkins Console Output.

Job Name  : ${env.JOB_NAME}
Build No  : ${env.BUILD_NUMBER}
Build URL : ${env.BUILD_URL}
"""
            )
        }
    }
}
