pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Run Tests') {
            steps {
                bat '''
                jmeter -n -t jenkins-pipeline-demo-BOth_API_and_Web.jmx ^
                -l result.jtl ^
                -e -o report
                '''
            }
        }

        stage('Publish HTML Report') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report'
                ])
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'result.jtl, report/**', fingerprint: true
        }

        success {
            echo 'Build Successful - Report Generated'

            emailext (
                subject: "SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Build successful. Check Jenkins report.",
                to: "bavishasundaram@gmail.com"
            )
        }

        failure {
            echo 'Build Failed'

            emailext (
                subject: "FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Build failed. Check logs.",
                to: "bavishasundaram@gmail.com"
            )
        }
    }
}
