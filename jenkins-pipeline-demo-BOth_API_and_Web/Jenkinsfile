pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul
                rmdir /s /q zipreport 2>nul

                mkdir results
                mkdir report
                mkdir zipreport
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat """
                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl
                """
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx ^
                -l results\\api.jtl
                """
            }
        }

        stage('Generate Reports') {
            steps {
                bat """
                echo Generating WEB Report...
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web

                echo Generating API Report...
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api
                """
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                echo ================= WEB REPORT =================
                dir report\\web

                echo ================= API REPORT =================
                dir report\\api
                '''
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web `
                -DestinationPath zipreport\\WEB_Report.zip -Force

                Compress-Archive -Path report\\api `
                -DestinationPath zipreport\\API_Report.zip -Force
                '''
            }
        }

        stage('Verify ZIP Reports') {
            steps {
                bat '''
                echo ================= ZIP REPORTS =================

                dir zipreport
                '''
            }
        }

        stage('Publish Reports') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])
            }
        }
    }

    post {

        success {

            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "WEB & API JMeter Report - SUCCESS - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: SUCCESS

WEB and API Reports Generated Successfully.

================ REPORT LINKS ================

WEB HTML Report:
${env.BUILD_URL}WEB_HTML_Report/

API HTML Report:
${env.BUILD_URL}API_HTML_Report/

================ ZIP DOWNLOAD LINKS ================

WEB ZIP:
${env.BUILD_URL}artifact/zipreport/WEB_Report.zip

API ZIP:
${env.BUILD_URL}artifact/zipreport/API_Report.zip
                """,

                mimeType: 'text/plain'
            )
        }

        failure {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "WEB & API JMeter Report - FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: FAILURE

Please check Jenkins Console Output.
                """
            )
        }
    }
}
