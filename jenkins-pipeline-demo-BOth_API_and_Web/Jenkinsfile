pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Old Files') {
            steps {
                bat '''
                echo Cleaning old folders...

                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul
                rmdir /s /q zipreport 2>nul

                mkdir results
                mkdir report
                mkdir report\\web
                mkdir report\\api
                mkdir zipreport
                '''
            }
        }

        stage('Verify JMX Files') {
            steps {
                bat '''
                echo ================= VERIFY WEB FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\web

                echo ================= VERIFY API FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\api
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat """
                echo Running WEB Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl

                echo WEB Test Completed
                """
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                echo Running API Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx ^
                -l results\\api.jtl

                echo API Test Completed
                """
            }
        }

        stage('Generate HTML Reports') {
            steps {
                bat """
                echo Generating WEB HTML Report...
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web

                echo Generating API HTML Report...
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api
                """
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* `
                -DestinationPath zipreport\\WEB_Report.zip -Force

                Compress-Archive -Path report\\api\\* `
                -DestinationPath zipreport\\API_Report.zip -Force
                '''
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                echo ================= WEB REPORT =================
                dir report\\web

                echo ================= API REPORT =================
                dir report\\api

                echo ================= ZIP REPORTS =================
                dir zipreport

                if exist zipreport\\WEB_Report.zip (
                    echo WEB ZIP Report Generated Successfully
                ) else (
                    echo WEB ZIP Report NOT Generated
                    exit /b 1
                )

                if exist zipreport\\API_Report.zip (
                    echo API ZIP Report Generated Successfully
                ) else (
                    echo API ZIP Report NOT Generated
                    exit /b 1
                )
                '''
            }
        }

        stage('Publish Reports') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])
            }
        }
    }

    post {

        success {

            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB & API Report - SUCCESS - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: SUCCESS

WEB and API HTML Reports Generated Successfully.

================ REPORT LINKS ================

WEB HTML Report:
${env.BUILD_URL}WEB_HTML_Report/

API HTML Report:
${env.BUILD_URL}API_HTML_Report/

================ DOWNLOAD ZIP FILES ================

WEB ZIP Report:
${env.BUILD_URL}artifact/zipreport/WEB_Report.zip

API ZIP Report:
${env.BUILD_URL}artifact/zipreport/API_Report.zip
                """,

                mimeType: 'text/plain'
            )
        }

        failure {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB & API Report - FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: FAILURE

WEB/API Report Generation Failed.
                """
            )
        }
    }
}
