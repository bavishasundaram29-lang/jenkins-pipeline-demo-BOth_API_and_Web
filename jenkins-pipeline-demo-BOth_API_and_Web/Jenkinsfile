pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Create Reports') {
            parallel {

                stage('Web Report') {
                    steps {
                        bat """
                        mkdir report\\web
                        echo Web Report Generated Successfully > report\\web\\web-report.html
                        """
                    }
                }

                stage('API Report') {
                    steps {
                        bat """
                        mkdir report\\api
                        echo API Report Generated Successfully > report\\api\\api-report.html
                        """
                    }
                }
            }
        }

        stage('Dashboard') {
            steps {
                bat """
                mkdir report\\dashboard
                echo ^<html^>^<body^>Dashboard Generated^</body^>^</html^> > report\\dashboard\\index.html
                """
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: 'report/**', fingerprint: true
            }
        }
    }

    post {

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✅ Jenkins Build SUCCESS - Reports Ready",
                body: """
                🎉 Build Successful: ${JOB_NAME} #${BUILD_NUMBER}

                📊 Reports Generated:
                - Web Report
                - API Report
                - Dashboard

                📦 Download Artifacts:
                ${BUILD_URL}artifact/report/

                ✔ Open Jenkins build to access all reports.
                """
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins Build FAILED",
                body: """
                Build Failed: ${JOB_NAME} #${BUILD_NUMBER}

                Check logs:
                ${BUILD_URL}
                """
            )
        }
    }
}
