pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report
                if exist artifacts rmdir /s /q artifacts

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                mkdir artifacts
                '''
            }
        }

        stage('Run API + WEB Tests in Parallel') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx ^
                        -l results\\api.jtl
                        """
                    }
                }

                stage('WEB Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl
                        """
                    }
                }
            }
        }

        stage('Generate HTML Reports') {
            steps {
                bat '''
                if exist report\\api rmdir /s /q report\\api
                if exist report\\web rmdir /s /q report\\web

                mkdir report\\api
                mkdir report\\web

                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                '''
            }
        }

        stage('Prepare Email Artifacts (ZIP Reports)') {
            steps {
                bat '''
                powershell Compress-Archive -Path report\\api\\* -DestinationPath artifacts\\API_Report.zip -Force
                powershell Compress-Archive -Path report\\web\\* -DestinationPath artifacts\\WEB_Report.zip -Force
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])
            }
        }
    }

    post {
        always {

            archiveArtifacts artifacts: 'results/*.jtl, artifacts/*.zip', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',
                subject: "Jenkins Report - Build ${env.BUILD_NUMBER}",
                body: """
Build Status: ${currentBuild.currentResult}

✔ API Report attached
✔ WEB Report attached

Check Jenkins UI for full HTML dashboards.
""",
                attachmentsPattern: 'artifacts/API_Report.zip, artifacts/WEB_Report.zip'
            )
        }
    }
}
