pipeline {
    agent any

    environment {
        REPORT_DIR = "report"
        WEB_DIR = "report\\web"
        API_DIR = "report\\api"
        DASHBOARD_DIR = "report\\dashboard"
        ZIP_DIR = "report\\zips"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                bat 'if exist report rmdir /s /q report'
            }
        }

        stage('Create Directories') {
            steps {
                bat """
                if not exist report mkdir report
                if not exist report\\web mkdir report\\web
                if not exist report\\api mkdir report\\api
                if not exist report\\dashboard mkdir report\\dashboard
                if not exist report\\zips mkdir report\\zips
                """
            }
        }

        stage('Build Web Report') {
            steps {
                bat """
                echo Generating Web Report...
                echo Web Report Success > report\\web\\web-report.html
                """
            }
        }

        stage('Build API Report') {
            steps {
                bat """
                echo Generating API Report...
                echo API Report Success > report\\api\\api-report.html
                """
            }
        }

        stage('Create Dashboard') {
            steps {
                bat """
                echo ^<html^> > report\\dashboard\\index.html
                echo ^<body^> >> report\\dashboard\\index.html
                echo ^<h1^>Test Dashboard^</h1^> >> report\\dashboard\\index.html
                echo ^<p^>Web Report Generated^</p^> >> report\\dashboard\\index.html
                echo ^<p^>API Report Generated^</p^> >> report\\dashboard\\index.html
                echo ^</body^> >> report\\dashboard\\index.html
                echo ^</html^> >> report\\dashboard\\index.html
                """
            }
        }

        stage('Zip Reports') {
            steps {
                bat """
                powershell Compress-Archive -Path report\\web\\* -DestinationPath report\\zips\\web.zip -Force
                powershell Compress-Archive -Path report\\api\\* -DestinationPath report\\zips\\api.zip -Force
                """
            }
        }
    }

    post {

        success {
            emailext (
                to: "bavishausndar@gmail.com",
                subject: "✅ Jenkins Build SUCCESS - Web & API Reports",
                body: """
Hello,

Your Jenkins build completed successfully.

📊 Reports Generated:
- Web Report: report/web/web-report.html
- API Report: report/api/api-report.html
- Dashboard: report/dashboard/index.html

📦 ZIP Files:
- report/zips/web.zip
- report/zips/api.zip

Check Jenkins workspace for full details.

Regards,
Jenkins Pipeline
"""
            )
        }

        failure {
            emailext (
                to: "bavishausndar@gmail.com",
                subject: "❌ Jenkins Build FAILED - Web & API Reports",
                body: """
Hello,

Your Jenkins build has failed.

Please check Jenkins logs for errors.

Regards,
Jenkins Pipeline
"""
            )
        }

        always {
            archiveArtifacts artifacts: 'report/**', fingerprint: true
        }
    }
}
