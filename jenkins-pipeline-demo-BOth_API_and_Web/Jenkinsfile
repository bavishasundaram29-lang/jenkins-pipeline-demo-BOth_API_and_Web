pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\Apache\\apache-jmeter-5.6.3"
        RESULTS_DIR = "results"
        REPORT_DIR_API = "report_api"
        REPORT_DIR_WEB = "report_web"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                mkdir %RESULTS_DIR%\\api
                jmeter -n -t api_test.jmx ^
                -l %RESULTS_DIR%\\api\\api.jtl ^
                -e -o %REPORT_DIR_API%
                """
            }
        }

        stage('Run Web Test') {
            steps {
                bat """
                mkdir %RESULTS_DIR%\\web
                jmeter -n -t web_test.jmx ^
                -l %RESULTS_DIR%\\web\\web.jtl ^
                -e -o %REPORT_DIR_WEB%
                """
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: '**/report_api/**, **/report_web/**, **/results/**', fingerprint: true
            }
        }

        stage('Publish Jenkins UI Report') {
            steps {
                publishHTML([
                    reportDir: 'report_api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report'
                ])

                publishHTML([
                    reportDir: 'report_web',
                    reportFiles: 'index.html',
                    reportName: 'Web HTML Report'
                ])
            }
        }
    }

    post {
        always {

            emailext (
                subject: "Jenkins Build Report - API & Web Tests",
                body: """
                Hi Team,

                Please find attached API and Web test reports.

                Jenkins Build: ${env.BUILD_NUMBER}

                Regards,
                Jenkins
                """,
                
                to: "yourmail@gmail.com",

                attachmentsPattern: """
                    report_api/index.html,
                    report_web/index.html
                """,

                mimeType: 'text/html'
            )
        }
    }
}
