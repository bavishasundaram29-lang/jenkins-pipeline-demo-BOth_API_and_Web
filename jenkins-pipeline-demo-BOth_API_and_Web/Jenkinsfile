pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Run API and Web Tests in Parallel') {

            parallel {

                stage('API Test') {
                    steps {
                        bat '''
                        jmeter -n -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx -l api_result.jtl
                        '''
                    }
                }

                stage('Web Test') {
                    steps {
                        bat '''
                        jmeter -n -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx -l web_result.jtl
                        '''
                    }
                }
            }
        }

        stage('Generate API HTML Report') {
            steps {
                bat '''
                if exist api_report rmdir /s /q api_report
                jmeter -g api_result.jtl -o api_report
                '''
            }
        }

        stage('Generate Web HTML Report') {
            steps {
                bat '''
                if exist web_report rmdir /s /q web_report
                jmeter -g web_result.jtl -o web_report
                '''
            }
        }

        stage('Publish API HTML Report') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'api_report',
                    reportFiles: 'index.html',
                    reportName: 'API JMeter Report'
                ])
            }
        }

        stage('Publish Web HTML Report') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'web_report',
                    reportFiles: 'index.html',
                    reportName: 'Web JMeter Report'
                ])
            }
        }
    }

    post {

        always {

            emailext(
                subject: "Jenkins Build Report - ${BUILD_NUMBER}",

                body: """
                <h2>Jenkins JMeter Execution Report</h2>

                <p>Build completed successfully.</p>

                <p><b>Build Number:</b> ${BUILD_NUMBER}</p>

                <p>API and Web scripts executed in parallel successfully.</p>

                <p>Reports have been attached.</p>
                """,

                mimeType: 'text/html',

                to: 'bavishasundar@gmail.com',

                attachmentsPattern: 'api_report/**/*, web_report/**/*'
            )
        }
    }
}
