pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report

                mkdir results

                mkdir report
                mkdir report\\api
                mkdir report\\web
                '''
            }
        }

        stage('Run API + Web Parallel') {

            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx ^
                        -l results\\api.jtl ^
                        -e -o report\\api
                        """
                    }
                }

                stage('Web Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl ^
                        -e -o report\\web
                        """
                    }
                }
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: 'results/**, report/**', fingerprint: true

            // API Report in Jenkins UI
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report/api',
                reportFiles: 'index.html',
                reportName: 'API JMeter Report'
            ])

            // WEB Report in Jenkins UI
            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report/web',
                reportFiles: 'index.html',
                reportName: 'WEB JMeter Report'
            ])
        }

        success {

            emailext(
                to: "bavishasundar@gmail.com",

                subject: "✔ Jenkins SUCCESS - API + WEB Reports",

                body: """
Build SUCCESS

✔ API Test Executed
✔ WEB Test Executed

Separate reports generated successfully.

Reports Available:
- API Report
- WEB Report

Reports are available in:
1. Jenkins UI
2. Jenkins Workspace
3. Email Attachments

Job Name : ${env.JOB_NAME}
Build No : ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
""",

                mimeType: 'text/plain',

                attachmentsPattern: """
report/api/**,
report/web/**
"""
            )
        }

        failure {

            emailext(
                to: "bavishasundar@gmail.com",

                subject: "❌ Jenkins FAILED - API + WEB",

                body: """
Build FAILED

Check Jenkins Console Output for errors.

Job Name : ${env.JOB_NAME}
Build No : ${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}
"""
            )
        }
    }
}
