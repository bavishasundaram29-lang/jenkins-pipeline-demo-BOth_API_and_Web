pipeline {

    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {

                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {

                bat '''
                echo Cleaning Workspace...

                if exist results rmdir /s /q results
                if exist report rmdir /s /q report
                if exist zipreport rmdir /s /q zipreport

                mkdir results
                mkdir report
                mkdir report\\web
                mkdir report\\api
                mkdir report\\aggregate
                mkdir zipreport
                '''
            }
        }

        stage('Verify Files') {
            steps {

                bat '''
                echo ================= WEB FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\web

                echo ================= API FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\api
                '''
            }
        }

        stage('Run WEB Test') {
            steps {

                bat '''
                echo Running WEB Test...

                "%JMETER_HOME%\\bin\\jmeter.bat" -n -t "jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx" -l "results\\web.jtl" -e -o "report\\web"

                echo WEB Test Completed
                '''
            }
        }

        stage('Run API Test') {
            steps {

                bat '''
                echo Running API Test...

                "%JMETER_HOME%\\bin\\jmeter.bat" -n -t "jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx" -l "results\\api.jtl" -e -o "report\\api"

                echo API Test Completed
                '''
            }
        }

        stage('Generate Aggregate Report') {
            steps {

                bat '''
                echo Creating Combined Aggregate CSV...

                copy /b results\\web.jtl + results\\api.jtl results\\final.jtl

                "%JMETER_HOME%\\bin\\jmeter.bat" -g "results\\final.jtl" -o "report\\aggregate"

                echo Aggregate Report Generated
                '''
            }
        }

        stage('Verify Reports') {
            steps {

                bat '''
                echo ================= WEB REPORT =================
                dir report\\web

                echo ================= API REPORT =================
                dir report\\api

                echo ================= AGGREGATE REPORT =================
                dir report\\aggregate

                if exist report\\web\\index.html (
                    echo WEB Report Generated
                ) else (
                    echo WEB Report Failed
                    exit /b 1
                )

                if exist report\\api\\index.html (
                    echo API Report Generated
                ) else (
                    echo API Report Failed
                    exit /b 1
                )

                if exist report\\aggregate\\index.html (
                    echo Aggregate Report Generated
                ) else (
                    echo Aggregate Report Failed
                    exit /b 1
                )
                '''
            }
        }

        stage('Create ZIP Reports') {
            steps {

                powershell '''
                Compress-Archive -Path report\\web\\* -DestinationPath zipreport\\WEB_Report.zip -Force

                Compress-Archive -Path report\\api\\* -DestinationPath zipreport\\API_Report.zip -Force

                Compress-Archive -Path report\\aggregate\\* -DestinationPath zipreport\\Aggregate_Report.zip -Force
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/aggregate',
                    reportFiles: 'index.html',
                    reportName: 'Aggregate_HTML_Report'
                ])
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip', fingerprint: true
        }

        success {

            emailext(

                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB + API + Aggregate Reports SUCCESS - Build #${env.BUILD_NUMBER}",

                mimeType: 'text/html',

                body: """
<html>

<body>

<h2>JMeter Execution Summary</h2>

<table border="1" cellpadding="8" cellspacing="0">

<tr>
<th>Report Type</th>
<th>Status</th>
<th>Jenkins URL</th>
</tr>

<tr>
<td>WEB Report</td>
<td>SUCCESS</td>
<td>
<a href="${env.BUILD_URL}WEB_HTML_Report/">
Open WEB Report
</a>
</td>
</tr>

<tr>
<td>API Report</td>
<td>SUCCESS</td>
<td>
<a href="${env.BUILD_URL}API_HTML_Report/">
Open API Report
</a>
</td>
</tr>

<tr>
<td>Aggregate Report</td>
<td>SUCCESS</td>
<td>
<a href="${env.BUILD_URL}Aggregate_HTML_Report/">
Open Aggregate Report
</a>
</td>
</tr>

</table>

<br>

<h3>Download ZIP Reports</h3>

<ul>

<li>
<a href="${env.BUILD_URL}artifact/zipreport/WEB_Report.zip">
Download WEB ZIP
</a>
</li>

<li>
<a href="${env.BUILD_URL}artifact/zipreport/API_Report.zip">
Download API ZIP
</a>
</li>

<li>
<a href="${env.BUILD_URL}artifact/zipreport/Aggregate_Report.zip">
Download Aggregate ZIP
</a>
</li>

</ul>

<br>

<b>Job Name:</b> ${env.JOB_NAME}<br>
<b>Build Number:</b> ${env.BUILD_NUMBER}<br>

</body>
</html>
""",

                attachmentsPattern: 'zipreport/*.zip'
            )
        }

        failure {

            emailext(

                to: 'bavishasundar@gmail.com',

                subject: "JMeter Reports FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
Build FAILED

Check Console Output:
${env.BUILD_URL}console
"""
            )
        }
    }
}
