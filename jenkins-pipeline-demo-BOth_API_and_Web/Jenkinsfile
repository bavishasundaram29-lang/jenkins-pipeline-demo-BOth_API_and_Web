pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Old Files') {
            steps {
                bat '''
                echo Cleaning old folders...

                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul
                rmdir /s /q zipreport 2>nul

                mkdir results
                mkdir report
                mkdir report\\web
                mkdir zipreport
                '''
            }
        }

        stage('Verify WEB JMX File') {
            steps {
                bat '''
                echo ================= VERIFY WEB JMX =================

                dir jenkins-pipeline-demo-BOth_API_and_Web\\web
                '''
            }
        }

        stage('Run WEB JMeter Test') {
            steps {
                bat """
                echo Running WEB Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl

                echo WEB Test Completed
                """
            }
        }

        stage('Generate WEB HTML Report') {
            steps {
                bat """
                echo Generating WEB HTML Report...

                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                """
            }
        }

        stage('Create ZIP Report') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* `
                -DestinationPath zipreport\\WEB_Report.zip -Force
                '''
            }
        }

        stage('Verify WEB Report') {
            steps {
                bat '''
                echo ================= WEB REPORT =================

                dir report\\web

                echo ================= ZIP REPORT =================

                dir zipreport

                if exist zipreport\\WEB_Report.zip (
                    echo ZIP Report Generated Successfully
                ) else (
                    echo ZIP Report NOT Generated
                    exit /b 1
                )
                '''
            }
        }

        stage('Publish WEB Report') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])
            }
        }
    }

    post {

        success {

            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "WEB JMeter Report - SUCCESS - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: SUCCESS

WEB HTML Report Generated Successfully.

View HTML Report:
${env.BUILD_URL}WEB_HTML_Report/

Download ZIP Report:
${env.BUILD_URL}artifact/zipreport/WEB_Report.zip
                """,

                mimeType: 'text/plain'
            )
        }

        failure {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "WEB JMeter Report - FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: FAILURE

WEB HTML Report Generation Failed.
                """
            )
        }
    }
}
