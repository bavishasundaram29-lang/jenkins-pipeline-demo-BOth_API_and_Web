post {
    always {
        archiveArtifacts artifacts: 'result.jtl, report/**', fingerprint: true
    }

    success {
        echo 'Build Successful - Report Generated'

        emailext (
            subject: "Jenkins Build SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            body: "Build is successful.\n\nCheck report attached.",
            attachmentsPattern: "report/index.html",
            to: "bavishasundaram@gmail.com"
        )
    }

    failure {
        echo 'Build Failed - Check Logs'

        emailext (
            subject: "Jenkins Build FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
            body: "Build failed. Please check Jenkins logs.",
            to: "bavishasundarm@gmail.com"
        )
    }
}
