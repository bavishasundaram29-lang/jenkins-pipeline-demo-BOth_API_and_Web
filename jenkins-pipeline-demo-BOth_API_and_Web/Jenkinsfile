pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Create Reports') {
            parallel {

                stage('Web Report') {
                    steps {
                        bat """
                        mkdir report\\web
                        (
                        echo ^<html^>
                        echo ^<body^>
                        echo ^<h2^>Web Report^</h2^>
                        echo ^<p style='color:green'^>SUCCESS^</p^>
                        echo ^</body^>
                        echo ^</html^>
                        ) > report\\web\\web-report.html
                        """
                    }
                }

                stage('API Report') {
                    steps {
                        bat """
                        mkdir report\\api
                        (
                        echo ^<html^>
                        echo ^<body^>
                        echo ^<h2^>API Report^</h2^>
                        echo ^<p style='color:green'^>SUCCESS^</p^>
                        echo ^</body^>
                        echo ^</html^>
                        ) > report\\api\\api-report.html
                        """
                    }
                }
            }
        }

        stage('Dashboard') {
            steps {
                bat """
                mkdir report\\dashboard
                (
                echo ^<html^>
                echo ^<body^>
                echo ^<h2^>Dashboard^</h2^>
                echo ^<p^>All Systems OK^</p^>
                echo ^</body^>
                echo ^</html^>
                ) > report\\dashboard\\index.html
                """
            }
        }

        stage('Aggregate Report') {
            steps {
                bat """
                mkdir report\\aggregate
                (
                echo ^<html^>
                echo ^<body^>
                echo ^<h2^>Aggregate Report^</h2^>
                echo ^<table border='1' cellpadding='8'^>
                echo ^<tr^>^<th^>Module^</th^>^<th^>Status^</th^>^</tr^>
                echo ^<tr^>^<td^>Web Report^</td^>^<td^>SUCCESS^</td^>^</tr^>
                echo ^<tr^>^<td^>API Report^</td^>^<td^>SUCCESS^</td^>^</tr^>
                echo ^<tr^>^<td^>Dashboard^</td^>^<td^>SUCCESS^</td^>^</tr^>
                echo ^</table^>
                echo ^</body^>
                echo ^</html^>
                ) > report\\aggregate\\aggregate.html
                """
            }
        }

        stage('Publish Reports to Jenkins UI') {
            steps {

                publishHTML([
                    reportDir: 'report/web',
                    reportFiles: 'web-report.html',
                    reportName: 'Web Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/api',
                    reportFiles: 'api-report.html',
                    reportName: 'API Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/dashboard',
                    reportFiles: 'index.html',
                    reportName: 'Dashboard',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/aggregate',
                    reportFiles: 'aggregate.html',
                    reportName: 'Aggregate Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])
            }
        }
    }

    post {

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✅ Jenkins Build SUCCESS - Reports Ready",
                mimeType: "text/html",
                body: """
                <html>
                <body style="font-family: Arial;">

                <h2 style="color:green;">🎉 Build Successful</h2>

                <h3>📊 Aggregate Report</h3>

                <table border="1" cellpadding="8">
                    <tr>
                        <th>Module</th>
                        <th>Status</th>
                    </tr>
                    <tr>
                        <td>Web Report</td>
                        <td>SUCCESS</td>
                    </tr>
                    <tr>
                        <td>API Report</td>
                        <td>SUCCESS</td>
                    </tr>
                    <tr>
                        <td>Dashboard</td>
                        <td>SUCCESS</td>
                    </tr>
                </table>

                <h3>📦 Download Reports</h3>
                <ul>
                    <li><a href="${BUILD_URL}HTML_Report/Web_Report/">Web Report (Jenkins UI)</a></li>
                    <li><a href="${BUILD_URL}HTML_Report/API_Report/">API Report (Jenkins UI)</a></li>
                    <li><a href="${BUILD_URL}HTML_Report/Dashboard/">Dashboard (Jenkins UI)</a></li>
                    <li><a href="${BUILD_URL}HTML_Report/Aggregate_Report/">Aggregate Report</a></li>
                    <li><a href="${BUILD_URL}artifact/">Download Workspace Files</a></li>
                </ul>

                <p><b>Build:</b> ${JOB_NAME} #${BUILD_NUMBER}</p>

                </body>
                </html>
                """
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins Build FAILED",
                body: "Check logs: ${BUILD_URL}"
            )
        }
    }
}
