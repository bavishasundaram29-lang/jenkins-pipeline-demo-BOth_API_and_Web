pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\Apache\\apache-jmeter-5.6.3"
        RESULTS_DIR = "results"
        REPORT_API = "report_api"
        REPORT_WEB = "report_web"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                mkdir %RESULTS_DIR%\\api
                mkdir %REPORT_API%

                jmeter -n -t api_test.jmx ^
                -l %RESULTS_DIR%\\api\\api.jtl ^
                -j %RESULTS_DIR%\\api\\api.log ^
                -e -o %REPORT_API%
                """
            }
        }

        stage('Run Web Test') {
            steps {
                bat """
                mkdir %RESULTS_DIR%\\web
                mkdir %REPORT_WEB%

                jmeter -n -t web_test.jmx ^
                -l %RESULTS_DIR%\\web\\web.jtl ^
                -j %RESULTS_DIR%\\web\\web.log ^
                -e -o %REPORT_WEB%
                """
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: '''
                    report_api/**,
                    report_web/**,
                    results/**
                ''', fingerprint: true
            }
        }

        stage('Publish HTML Reports in Jenkins UI') {
            steps {
                publishHTML(target: [
                    reportDir: 'report_api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report',
                    keepAll: true,
                    allowMissing: false,
                    alwaysLinkToLastBuild: true
                ])

                publishHTML(target: [
                    reportDir: 'report_web',
                    reportFiles: 'index.html',
                    reportName: 'Web HTML Report',
                    keepAll: true,
                    allowMissing: false,
                    alwaysLinkToLastBuild: true
                ])
            }
        }
    }

    post {
        always {
            emailext (
                subject: "Jenkins API & Web Report - Build ${env.BUILD_NUMBER}",
                body: """
                Hi Team,

                Please find attached API and Web JMeter HTML reports.

                Build Number: ${env.BUILD_NUMBER}
                Status: ${currentBuild.currentResult}

                Regards,
                Jenkins
                """,
                to: "yourmail@gmail.com",
                mimeType: 'text/html',

                attachmentsPattern: '''
                    report_api/index.html,
                    report_web/index.html
                '''
            )
        }
    }
}
