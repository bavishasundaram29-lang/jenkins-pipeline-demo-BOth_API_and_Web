pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Verify Workspace') {
            steps {
                bat '''
                echo ================= WORKSPACE =================
                cd

                echo ================= ROOT FILES =================
                dir

                echo ================= SEARCH JMX FILE =================
                dir /s SCR01_Jpetstore.jmx
                '''
            }
        }

        stage('Clean Old Files') {
            steps {
                bat '''
                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul

                mkdir results
                mkdir report
                mkdir report\\web
                '''
            }
        }

        stage('Run WEB JMeter Test') {
            steps {
                bat """
                echo Running WEB Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t SCR01_Jpetstore.jmx ^
                -l results\\web.jtl

                echo WEB Test Completed
                """
            }
        }

        stage('Generate WEB HTML Report') {
            steps {
                bat """
                echo Generating WEB HTML Report...

                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                """
            }
        }

        stage('Verify WEB Report') {
            steps {
                bat '''
                echo ================= WEB REPORT =================
                dir report\\web

                if exist report\\web\\index.html (
                    echo WEB HTML Report Generated Successfully
                ) else (
                    echo WEB HTML Report NOT Generated
                )
                '''
            }
        }

        stage('Publish WEB Report') {
            steps {

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: 'results/*.jtl,report/**', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',
                subject: "WEB JMeter Report - Build #${env.BUILD_NUMBER}",
                body: """
Build Status: ${currentBuild.currentResult}

WEB HTML Report Generated Successfully.

Check Jenkins HTML Reports section.
                """,
                attachmentsPattern: 'report/**'
            )
        }
    }
}
