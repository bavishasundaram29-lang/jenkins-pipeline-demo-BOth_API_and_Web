pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Generate Reports') {
            parallel {

                stage('Web Report') {
                    steps {
                        bat """
                        mkdir report\\web
                        (
                        echo ^<html^>
                        echo ^<body^>
                        echo ^<h2^>Web Report^</h2^>
                        echo ^<p^>Web report generated successfully^</p^>
                        echo ^</body^>
                        echo ^</html^>
                        ) > report\\web\\web-report.html
                        """
                    }
                }

                stage('API Report') {
                    steps {
                        bat """
                        mkdir report\\api
                        (
                        echo ^<html^>
                        echo ^<body^>
                        echo ^<h2^>API Report^</h2^>
                        echo ^<p^>API report generated successfully^</p^>
                        echo ^</body^>
                        echo ^</html^>
                        ) > report\\api\\api-report.html
                        """
                    }
                }
            }
        }

        stage('Aggregate Report') {
            steps {
                bat """
                mkdir report\\aggregate
                (
                echo ^<html^>
                echo ^<body^>
                echo ^<h2^>Aggregate Report^</h2^>
                echo ^<table border='1' cellpadding='8'^>
                echo ^<tr^>^<th^>Module^</th^>^<th^>Status^</th^>^</tr^>
                echo ^<tr^>^<td^>Web Report^</td^>^<td^>Completed^</td^>^</tr^>
                echo ^<tr^>^<td^>API Report^</td^>^<td^>Completed^</td^>^</tr^>
                echo ^</table^>
                echo ^</body^>
                echo ^</html^>
                ) > report\\aggregate\\aggregate.html
                """
            }
        }

        stage('Publish to Jenkins UI') {
            steps {

                publishHTML([
                    reportDir: 'report/web',
                    reportFiles: 'web-report.html',
                    reportName: 'Web Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/api',
                    reportFiles: 'api-report.html',
                    reportName: 'API Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/aggregate',
                    reportFiles: 'aggregate.html',
                    reportName: 'Aggregate Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])
            }
        }
    }

    post {

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✅ Jenkins Build SUCCESS - Reports Ready",
                mimeType: "text/html",
                body: """
                <html>
                <body style="font-family: Arial;">

                <h2 style="color:green;">🎉 Build Successful</h2>

                <h3>📊 Reports</h3>
                <ul>
                    <li>✔ Full Web Report → <a href="${BUILD_URL}HTML_Report/Web_Report/">Open Report</a></li>
                    <li>✔ Full API Report → <a href="${BUILD_URL}HTML_Report/API_Report/">Open Report</a></li>
                </ul>

                <h3>📊 Aggregate Table</h3>
                <table border="1" cellpadding="8">
                    <tr>
                        <th>Module</th>
                        <th>Status</th>
                    </tr>
                    <tr>
                        <td>Web Report</td>
                        <td>Completed</td>
                    </tr>
                    <tr>
                        <td>API Report</td>
                        <td>Completed</td>
                    </tr>
                </table>

                <h3>📦 Download Links</h3>
                <ul>
                    <li><a href="${BUILD_URL}artifact/report/web/web-report.html">Download Web Report</a></li>
                    <li><a href="${BUILD_URL}artifact/report/api/api-report.html">Download API Report</a></li>
                    <li><a href="${BUILD_URL}artifact/report/aggregate/aggregate.html">Download Aggregate Report</a></li>
                    <li><a href="${BUILD_URL}artifact/">Download All Workspace Files</a></li>
                </ul>

                <p><b>Build:</b> ${JOB_NAME} #${BUILD_NUMBER}</p>

                </body>
                </html>
                """
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins Build FAILED",
                body: "Check logs: ${BUILD_URL}"
            )
        }
    }
}
