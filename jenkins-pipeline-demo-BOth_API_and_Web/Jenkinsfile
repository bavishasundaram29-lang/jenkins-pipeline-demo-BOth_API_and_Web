pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report
                if exist artifacts rmdir /s /q artifacts

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                mkdir artifacts
                '''
            }
        }

        stage('Run API + WEB Tests in Parallel') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx ^
                        -l results\\api.jtl
                        """
                    }
                }

                stage('WEB Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl
                        """
                    }
                }
            }
        }

        stage('Generate Separate HTML Reports') {
            steps {
                bat '''
                if exist report\\api rmdir /s /q report\\api
                if exist report\\web rmdir /s /q report\\web

                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                '''
            }
        }

        stage('Archive Reports for Email') {
            steps {
                bat '''
                mkdir artifacts\\API_Report
                mkdir artifacts\\WEB_Report

                xcopy /E /I report\\api artifacts\\API_Report
                xcopy /E /I report\\web artifacts\\WEB_Report
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])
            }
        }
    }

    post {
        always {

            archiveArtifacts artifacts: 'results/*.jtl, artifacts/**/*', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',
                subject: "Jenkins Report: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                Build Status: ${currentBuild.currentResult}

                ✔ API Test Completed
                ✔ WEB Test Completed
                ✔ Reports Generated

                📁 Attached Folders:
                - API_Report
                - WEB_Report

                Check Jenkins UI for HTML dashboards.
                """,

                attachmentsPattern: 'artifacts/**/*.html, artifacts/**/*.css, artifacts/**/*.js'
            )
        }
    }
}
