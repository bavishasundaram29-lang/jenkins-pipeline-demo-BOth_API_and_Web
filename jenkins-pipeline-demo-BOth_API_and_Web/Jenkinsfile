pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                echo Cleaning workspace...

                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul
                rmdir /s /q zipreport 2>nul

                mkdir results
                mkdir report
                mkdir zipreport
                '''
            }
        }

        stage('Verify Files') {
            steps {
                bat '''
                echo ================= WEB FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\web

                echo ================= API FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\api
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat """
                echo Running WEB Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl ^
                -e -o report\\web

                echo WEB Test Completed
                """
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                echo Running API Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx ^
                -l results\\api.jtl ^
                -e -o report\\api

                echo API Test Completed
                """
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                echo ================= WEB REPORT =================
                dir report\\web

                echo ================= API REPORT =================
                dir report\\api

                if exist report\\web\\index.html (
                    echo WEB Report Generated
                ) else (
                    echo WEB Report Failed
                    exit /b 1
                )

                if exist report\\api\\index.html (
                    echo API Report Generated
                ) else (
                    echo API Report Failed
                    exit /b 1
                )
                '''
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* `
                -DestinationPath zipreport\\WEB_Report.zip -Force

                Compress-Archive -Path report\\api\\* `
                -DestinationPath zipreport\\API_Report.zip -Force
                '''
            }
        }

        stage('Verify ZIP Reports') {
            steps {
                bat '''
                echo ================= ZIP REPORTS =================
                dir zipreport
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])
            }
        }
    }

    post {

        success {

            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB & API Reports - SUCCESS - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: SUCCESS

================ WEB REPORT =================
${env.BUILD_URL}WEB_HTML_Report/

================ API REPORT =================
${env.BUILD_URL}API_HTML_Report/

================ DOWNLOAD ZIP FILES =================

WEB ZIP:
${env.BUILD_URL}artifact/zipreport/WEB_Report.zip

API ZIP:
${env.BUILD_URL}artifact/zipreport/API_Report.zip
                """,

                mimeType: 'text/plain',

                attachmentsPattern: 'zipreport/*.zip'
            )
        }

        failure {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB & API Reports - FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: FAILURE

Check Jenkins Console Output:
${env.BUILD_URL}console
                """
            )
        }
    }
}
