pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Validate Workspace') {
            steps {
                bat '''
                echo ROOT FILE STRUCTURE:
                dir
                echo API FOLDER:
                dir api
                echo WEB FOLDER:
                dir web
                '''
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                mkdir report\\final
                '''
            }
        }

        stage('Run API + Web (Parallel)') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t api/api_script.jmx ^
                        -l results\\api.jtl
                        """
                    }
                }

                stage('Web Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t web/SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl
                        """
                    }
                }
            }
        }

        stage('Generate Reports') {
            steps {
                bat '''
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                '''
            }
        }

        stage('Final Report') {
            steps {
                bat '''
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\final
                '''
            }
        }
    }

    post {

        always {
            publishHTML (target: [
                reportDir: 'report\\final',
                reportFiles: 'index.html',
                reportName: 'JMeter Final Report'
            ])
        }

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✔ Jenkins SUCCESS - API + WEB",
                body: """
Build SUCCESS

✔ API executed
✔ Web executed
✔ Reports generated

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins FAILED",
                body: """
Build FAILED

Check Jenkins logs.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
            )
        }
    }
}
