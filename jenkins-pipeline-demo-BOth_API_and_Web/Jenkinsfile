pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Run API and Web Tests in Parallel') {

            parallel {

                stage('API Test') {
                    steps {
                        bat '''
                        jmeter -n -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx -l api_result.jtl
                        '''
                    }
                }

                stage('Web Test') {
                    steps {
                        bat '''
                        jmeter -n -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx -l web_result.jtl
                        '''
                    }
                }
            }
        }

        stage('Generate Single HTML Report') {
            steps {
                bat '''
                if exist reports rmdir /s /q reports

                jmeter -g api_result.jtl -o temp_api_report
                jmeter -g web_result.jtl -o temp_web_report
                '''
            }
        }

        stage('Publish Report (API + Web Combined View)') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'temp_web_report',
                    reportFiles: 'index.html',
                    reportName: 'JMeter Combined HTML Report'
                ])
            }
        }
    }

    post {
        always {
            emailext(
                subject: "Jenkins Build Report - ${BUILD_NUMBER}",

                body: """
                <h2>Jenkins JMeter Execution Report</h2>

                <p><b>Build Number:</b> ${BUILD_NUMBER}</p>

                <p>API + Web tests executed successfully.</p>

                <p>HTML report generated and available in Jenkins UI.</p>
                """,

                mimeType: 'text/html',
                to: 'bavishasundar@gmail.com',
                attachmentsPattern: 'temp_web_report/**/*'
            )
        }
    }
}
