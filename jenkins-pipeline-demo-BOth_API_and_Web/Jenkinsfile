pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3\\bin"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report
                if exist zipreport rmdir /s /q zipreport

                mkdir results
                mkdir report
                mkdir report\\web
                mkdir report\\api
                mkdir zipreport
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat """
                "${JMETER_HOME}\\jmeter.bat" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx" ^
                -l "results\\web.jtl" ^
                -e -o "report\\web"
                """
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                "${JMETER_HOME}\\jmeter.bat" -n ^
                -t "jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx" ^
                -l "results\\api.jtl" ^
                -e -o "report\\api"
                """
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* -DestinationPath zipreport\\WEB_Report.zip -Force
                Compress-Archive -Path report\\api\\* -DestinationPath zipreport\\API_Report.zip -Force
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB HTML Report'
                ])

                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report'
                ])
            }
        }
    }

    post {
        always {

            archiveArtifacts artifacts: 'report/**/*, zipreport/*.zip', fingerprint: true

            emailext(
                subject: "JMeter Execution Report - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                mimeType: 'text/html',

                body: """
                <html>
                <body>

                <h2>JMeter Execution Report</h2>

                <table border="1" cellpadding="10" cellspacing="0" style="border-collapse:collapse;">
