pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist report rmdir /s /q report
                '''
            }
        }

        stage('Run API + Web Tests') {
            steps {
                bat """
                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web.jmx ^
                -l result.jtl ^
                -e -o report
                """
            }
        }

        stage('Publish HTML Report') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report'
                ])
            }
        }
    }

    post {

        always {
            archiveArtifacts artifacts: 'result.jtl, report/**', fingerprint: true
        }

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✔ Jenkins SUCCESS - HTML Report",
                body: """
Build SUCCESS

✔ HTML Report generated
✔ Available in Jenkins UI

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins FAILED",
                body: "Check Jenkins logs"
            )
        }
    }
}
