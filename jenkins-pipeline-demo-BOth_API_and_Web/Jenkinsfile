pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                '''
            }
        }

        stage('Run API + WEB Tests in Parallel') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx ^
                        -l results\\api.jtl ^
                        -Jjmeter.save.saveservice.output_format=csv
                        """
                    }
                }

                stage('WEB Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl ^
                        -Jjmeter.save.saveservice.output_format=csv ^
                        -Jjmeter.save.saveservice.assertion_results=none ^
                        -Jjmeter.save.saveservice.response_data=false
                        """
                    }
                }
            }
        }

        stage('Generate HTML Reports') {
            steps {
                bat '''
                echo === Generating API Report ===
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\api

                echo === Validating WEB JTL ===
                if not exist results\\web.jtl exit /b 1

                for %%A in (results\\web.jtl) do (
                    if %%~zA LSS 500 (
                        echo WEB JTL invalid
                        exit /b 1
                    )
                )

                echo === Generating WEB Report ===
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\web.jtl -o report\\web
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB HTML Report'
                ])
            }
        }
    }

    post {

        always {
            archiveArtifacts artifacts: 'report/**', fingerprint: true

            emailext(
                to: 'bavishasundar@gmail.com',
                subject: "Jenkins API + WEB Report - Build ${env.BUILD_NUMBER}",
                body: """
Build Status: ${currentBuild.currentResult}

✔ API Report Generated
✔ WEB Report Generated

Check attachments:
- report/api
- report/web
                """,
                attachmentsPattern: 'report/**/index.html,report/**/*.css,report/**/*.js'
            )
        }
    }
}
