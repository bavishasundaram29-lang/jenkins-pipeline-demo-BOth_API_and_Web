pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                echo Cleaning workspace...

                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul
                rmdir /s /q zipreport 2>nul
                rmdir /s /q aggregate 2>nul

                mkdir results
                mkdir report
                mkdir zipreport
                mkdir aggregate
                '''
            }
        }

        stage('Verify Files') {
            steps {
                bat '''
                echo ================= WEB FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\web

                echo ================= API FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\api
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat """
                echo Running WEB Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl ^
                -e -o report\\web

                echo WEB Test Completed
                """
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                echo Running API Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx ^
                -l results\\api.jtl ^
                -e -o report\\api

                echo API Test Completed
                """
            }
        }

        stage('Generate Aggregate Dashboard') {
            steps {

                powershell '''
                # WEB Aggregate
                $webCsv = Import-Csv "results\\web.jtl"

                $webTotal = $webCsv.Count
                $webPass = ($webCsv | Where-Object {$_.success -eq "true"}).Count
                $webFail = ($webCsv | Where-Object {$_.success -eq "false"}).Count
                $webAvg = [math]::Round((($webCsv.elapsed | Measure-Object -Average).Average),2)

                # API Aggregate
                $apiCsv = Import-Csv "results\\api.jtl"

                $apiTotal = $apiCsv.Count
                $apiPass = ($apiCsv | Where-Object {$_.success -eq "true"}).Count
                $apiFail = ($apiCsv | Where-Object {$_.success -eq "false"}).Count
                $apiAvg = [math]::Round((($apiCsv.elapsed | Measure-Object -Average).Average),2)

                # WEB HTML TABLE
                $webHtml = @"
                <html>
                <body>
                <h2>WEB Aggregate Report</h2>
                <table border='1' cellpadding='5' cellspacing='0'>
                    <tr>
                        <th>Total Samples</th>
                        <th>Passed</th>
                        <th>Failed</th>
                        <th>Average Response Time(ms)</th>
                    </tr>
                    <tr>
                        <td>$webTotal</td>
                        <td>$webPass</td>
                        <td>$webFail</td>
                        <td>$webAvg</td>
                    </tr>
                </table>
                </body>
                </html>
"@

                $webHtml | Out-File aggregate\\web_aggregate.html

                # API HTML TABLE
                $apiHtml = @"
                <html>
                <body>
                <h2>API Aggregate Report</h2>
                <table border='1' cellpadding='5' cellspacing='0'>
                    <tr>
                        <th>Total Samples</th>
                        <th>Passed</th>
                        <th>Failed</th>
                        <th>Average Response Time(ms)</th>
                    </tr>
                    <tr>
                        <td>$apiTotal</td>
                        <td>$apiPass</td>
                        <td>$apiFail</td>
                        <td>$apiAvg</td>
                    </tr>
                </table>
                </body>
                </html>
"@

                $apiHtml | Out-File aggregate\\api_aggregate.html
                '''
            }
        }

        stage('Verify Reports') {
            steps {
                bat '''
                echo ================= WEB REPORT =================
                dir report\\web

                echo ================= API REPORT =================
                dir report\\api

                echo ================= AGGREGATE REPORT =================
                dir aggregate
                '''
            }
        }

        stage('Create ZIP Reports') {
            steps {
                powershell '''
                Compress-Archive -Path report\\web\\* `
                -DestinationPath zipreport\\WEB_Report.zip -Force

                Compress-Archive -Path report\\api\\* `
                -DestinationPath zipreport\\API_Report.zip -Force
                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {
            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'aggregate',
                    reportFiles: 'web_aggregate.html',
                    reportName: 'WEB_Aggregate_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'aggregate',
                    reportFiles: 'api_aggregate.html',
                    reportName: 'API_Aggregate_Report'
                ])
            }
        }
    }

    post {

        success {

            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip,aggregate/*.html', fingerprint: true

            script {

                def webTable = readFile('aggregate/web_aggregate.html')
                def apiTable = readFile('aggregate/api_aggregate.html')

                emailext(
                    to: 'bavishasundar@gmail.com',

                    subject: "JMeter WEB & API Reports - SUCCESS - Build #${env.BUILD_NUMBER}",

                    mimeType: 'text/html',

                    body: """
                    <h2>Build Status : SUCCESS</h2>

                    <h3>WEB HTML REPORT</h3>
                    <a href="${env.BUILD_URL}WEB_HTML_Report/">Open WEB Report</a>

                    <br><br>

                    <h3>API HTML REPORT</h3>
                    <a href="${env.BUILD_URL}API_HTML_Report/">Open API Report</a>

                    <br><br>

                    <h2>WEB Aggregate Summary</h2>
                    ${webTable}

                    <br><br>

                    <h2>API Aggregate Summary</h2>
                    ${apiTable}

                    <br><br>

                    <h3>Download ZIP Reports</h3>

                    WEB ZIP:
                    <a href="${env.BUILD_URL}artifact/zipreport/WEB_Report.zip">
                    Download WEB ZIP
                    </a>

                    <br><br>

                    API ZIP:
                    <a href="${env.BUILD_URL}artifact/zipreport/API_Report.zip">
                    Download API ZIP
                    </a>
                    """,

                    attachmentsPattern: 'zipreport/*.zip'
                )
            }
        }

        failure {

            emailext(
                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB & API Reports - FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: FAILURE

Check Jenkins Console Output:
${env.BUILD_URL}console
                """
            )
        }
    }
}
