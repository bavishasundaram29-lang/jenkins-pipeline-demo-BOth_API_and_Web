pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace & Create Folders') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report

                mkdir results
                mkdir report
                mkdir report\\api
                mkdir report\\web
                mkdir report\\final
                '''
            }
        }

        stage('Run JMeter Tests (Parallel)') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t api_script.jmx ^
                        -l results\\api.jtl ^
                        -e -o report\\api
                        """
                    }
                }

                stage('Web Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl ^
                        -e -o report\\web
                        """
                    }
                }
            }
        }

        stage('Generate Final HTML Report') {
            steps {
                bat """
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\final
                """
            }
        }
    }

    post {

        always {
            publishHTML (target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report\\final',
                reportFiles: 'index.html',
                reportName: 'JMeter Final Report'
            ])
        }

        success {
            emailext (
                subject: " Jenkins Build SUCCESS - JMeter Report",
                body: """
                Hi,

                Your Jenkins build completed successfully.

                 Report is available in Jenkins UI (HTML Publisher)

                Job: ${env.JOB_NAME}
                Build No: ${env.BUILD_NUMBER}

                Regards,
                Jenkins Automation
                """,
                to: "bavishasundar@gmail.com"
            )
        }

        failure {
            emailext (
                subject: " Jenkins Build FAILED",
                body: """
                Hi,

                Your Jenkins build has failed.

                Please check console output.

                Job: ${env.JOB_NAME}
                Build No: ${env.BUILD_NUMBER}

                Regards,
                Jenkins
                """,
                to: "bavishasundar@gmail.com"
            )
        }
    }
}
