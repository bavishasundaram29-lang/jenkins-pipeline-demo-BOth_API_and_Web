pipeline {

    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout Code') {
            steps {

                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {

                bat '''
                echo Cleaning workspace...

                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul
                rmdir /s /q zipreport 2>nul
                rmdir /s /q aggregate 2>nul

                mkdir results
                mkdir report
                mkdir zipreport
                mkdir aggregate
                '''
            }
        }

        stage('Verify Files') {
            steps {

                bat '''
                echo ================= WEB FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\web

                echo ================= API FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\api
                '''
            }
        }

        stage('Run WEB Test') {
            steps {

                bat """
                echo Running WEB Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl ^
                -e -o report\\web

                echo WEB Test Completed
                """
            }
        }

        stage('Run API Test') {
            steps {

                bat """
                echo Running API Test...

                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx ^
                -l results\\api.jtl ^
                -e -o report\\api

                echo API Test Completed
                """
            }
        }

        stage('Generate Aggregate Dashboard') {

            steps {

                powershell '''

                function Get-Percentile {
                    param(
                        [double[]]$data,
                        [double]$percentile
                    )

                    $sorted = $data | Sort-Object
                    $index = [math]::Ceiling(($percentile / 100) * $sorted.Count) - 1

                    if ($index -lt 0) {
                        $index = 0
                    }

                    return $sorted[$index]
                }

                # ==========================================================
                # WEB REPORT
                # ==========================================================

                $webCsv = Import-Csv "results\\web.jtl"

                $webElapsed = $webCsv.elapsed | ForEach-Object { [double]$_ }

                $webTotal = $webCsv.Count
                $webPass = ($webCsv | Where-Object {$_.success -eq "true"}).Count
                $webFail = ($webCsv | Where-Object {$_.success -eq "false"}).Count

                $webAvg = [math]::Round((($webElapsed | Measure-Object -Average).Average),2)
                $webMedian = [math]::Round((Get-Percentile $webElapsed 50),2)
                $web90 = [math]::Round((Get-Percentile $webElapsed 90),2)
                $web95 = [math]::Round((Get-Percentile $webElapsed 95),2)

                $webMin = ($webElapsed | Measure-Object -Minimum).Minimum
                $webMax = ($webElapsed | Measure-Object -Maximum).Maximum

                $webStart = ($webCsv.timeStamp | Measure-Object -Minimum).Minimum
                $webEnd = ($webCsv.timeStamp | Measure-Object -Maximum).Maximum

                $webDuration = ($webEnd - $webStart) / 1000

                if ($webDuration -eq 0) {
                    $webThroughput = 0
                }
                else {
                    $webThroughput = [math]::Round(($webTotal / $webDuration),2)
                }

                $webHtml = @"
<html>
<body>

<h1>WEB Aggregate Report</h1>

<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;font-family:Arial;'>

<tr bgcolor='#D3D3D3'>
<th>Total Samples</th>
<th>Passed</th>
<th>Failed</th>
<th>Average Response Time(ms)</th>
</tr>

<tr>
<td>$webTotal</td>
<td>$webPass</td>
<td>$webFail</td>
<td>$webAvg</td>
</tr>

</table>

<br><br>

<h2>WEB Detailed Aggregate Report</h2>

<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;font-family:Arial;'>

<tr bgcolor='#D3D3D3'>
<th>Median(ms)</th>
<th>90th Percentile(ms)</th>
<th>95th Percentile(ms)</th>
<th>Min Response(ms)</th>
<th>Max Response(ms)</th>
<th>Throughput(req/sec)</th>
</tr>

<tr>
<td>$webMedian</td>
<td>$web90</td>
<td>$web95</td>
<td>$webMin</td>
<td>$webMax</td>
<td>$webThroughput</td>
</tr>

</table>

</body>
</html>
"@

                $webHtml | Out-File aggregate\\web_aggregate.html -Encoding utf8

                # ==========================================================
                # API REPORT
                # ==========================================================

                $apiCsv = Import-Csv "results\\api.jtl"

                $apiElapsed = $apiCsv.elapsed | ForEach-Object { [double]$_ }

                $apiTotal = $apiCsv.Count
                $apiPass = ($apiCsv | Where-Object {$_.success -eq "true"}).Count
                $apiFail = ($apiCsv | Where-Object {$_.success -eq "false"}).Count

                $apiAvg = [math]::Round((($apiElapsed | Measure-Object -Average).Average),2)
                $apiMedian = [math]::Round((Get-Percentile $apiElapsed 50),2)
                $api90 = [math]::Round((Get-Percentile $apiElapsed 90),2)
                $api95 = [math]::Round((Get-Percentile $apiElapsed 95),2)

                $apiMin = ($apiElapsed | Measure-Object -Minimum).Minimum
                $apiMax = ($apiElapsed | Measure-Object -Maximum).Maximum

                $apiStart = ($apiCsv.timeStamp | Measure-Object -Minimum).Minimum
                $apiEnd = ($apiCsv.timeStamp | Measure-Object -Maximum).Maximum

                $apiDuration = ($apiEnd - $apiStart) / 1000

                if ($apiDuration -eq 0) {
                    $apiThroughput = 0
                }
                else {
                    $apiThroughput = [math]::Round(($apiTotal / $apiDuration),2)
                }

                $apiHtml = @"
<html>
<body>

<h1>API Aggregate Report</h1>

<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;font-family:Arial;'>

<tr bgcolor='#D3D3D3'>
<th>Total Samples</th>
<th>Passed</th>
<th>Failed</th>
<th>Average Response Time(ms)</th>
</tr>

<tr>
<td>$apiTotal</td>
<td>$apiPass</td>
<td>$apiFail</td>
<td>$apiAvg</td>
</tr>

</table>

<br><br>

<h2>API Detailed Aggregate Report</h2>

<table border='1' cellpadding='6' cellspacing='0' style='border-collapse:collapse;font-family:Arial;'>

<tr bgcolor='#D3D3D3'>
<th>Median(ms)</th>
<th>90th Percentile(ms)</th>
<th>95th Percentile(ms)</th>
<th>Min Response(ms)</th>
<th>Max Response(ms)</th>
<th>Throughput(req/sec)</th>
</tr>

<tr>
<td>$apiMedian</td>
<td>$api90</td>
<td>$api95</td>
<td>$apiMin</td>
<td>$apiMax</td>
<td>$apiThroughput</td>
</tr>

</table>

</body>
</html>
"@

                $apiHtml | Out-File aggregate\\api_aggregate.html -Encoding utf8

                '''
            }
        }

        stage('Create ZIP Reports') {

            steps {

                powershell '''

                Compress-Archive -Path report\\web\\* `
                -DestinationPath zipreport\\WEB_Report.zip -Force

                Compress-Archive -Path report\\api\\* `
                -DestinationPath zipreport\\API_Report.zip -Force

                '''
            }
        }

        stage('Publish Reports in Jenkins UI') {

            steps {

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API_HTML_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'aggregate',
                    reportFiles: 'web_aggregate.html',
                    reportName: 'WEB_Aggregate_Report'
                ])

                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'aggregate',
                    reportFiles: 'api_aggregate.html',
                    reportName: 'API_Aggregate_Report'
                ])
            }
        }
    }

    post {

        success {

            archiveArtifacts artifacts: 'results/*.jtl,report/**,zipreport/*.zip,aggregate/*.html', fingerprint: true

            script {

                def webTable = readFile(file: 'aggregate/web_aggregate.html', encoding: 'UTF-8')
                def apiTable = readFile(file: 'aggregate/api_aggregate.html', encoding: 'UTF-8')

                emailext(

                    to: 'bavishasundar@gmail.com',

                    subject: "JMeter WEB & API Reports - SUCCESS - Build #${env.BUILD_NUMBER}",

                    mimeType: 'text/html',

                    body: """
<html>
<body>

<h1>JMeter Execution Report</h1>

<h2>Build Status : SUCCESS</h2>

<br>

<h2>WEB HTML REPORT</h2>

<a href="${env.BUILD_URL}WEB_HTML_Report/">
Open WEB HTML Report
</a>

<br><br>

<h2>API HTML REPORT</h2>

<a href="${env.BUILD_URL}API_HTML_Report/">
Open API HTML Report
</a>

<br><br>

${webTable}

<br><br>

${apiTable}

<br><br>

<h2>Download ZIP Reports</h2>

WEB ZIP:
<a href="${env.BUILD_URL}artifact/zipreport/WEB_Report.zip">
Download WEB ZIP
</a>

<br><br>

API ZIP:
<a href="${env.BUILD_URL}artifact/zipreport/API_Report.zip">
Download API ZIP
</a>

</body>
</html>
                    """,

                    attachmentsPattern: 'zipreport/*.zip'
                )
            }
        }

        failure {

            emailext(

                to: 'bavishasundar@gmail.com',

                subject: "JMeter WEB & API Reports - FAILURE - Build #${env.BUILD_NUMBER}",

                body: """
Build Status: FAILURE

Check Jenkins Console Output:
${env.BUILD_URL}console
                """
            )
        }
    }
}
