pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
        RESULTS_DIR = "results"
        REPORT_DIR  = "report"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat 'if exist results rmdir /s /q results'
                bat 'if exist report rmdir /s /q report'
                bat 'mkdir results'
            }
        }

        stage('Run JMeter Tests Parallel') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t api_test.jmx ^
                        -l results\\api.jtl ^
                        -e -o report\\api
                        """
                    }
                }

                stage('Web Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t web_test.jmx ^
                        -l results\\web.jtl ^
                        -e -o report\\web
                        """
                    }
                }
            }
        }

        stage('Generate Consolidated HTML Report') {
            steps {
                bat """
                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\final
                """
            }
        }
    }

    post {

        always {
            // Publish HTML report in Jenkins UI
            publishHTML (target: [
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report\\final',
                reportFiles: 'index.html',
                reportName: 'JMeter HTML Report'
            ])
        }

        success {
            emailext (
                subject: "Jenkins Build Success - JMeter Report",
                body: """
                Hi,

                Build completed successfully.

                Report is attached / available in Jenkins UI.

                Job: ${env.JOB_NAME}
                Build Number: ${env.BUILD_NUMBER}

                Regards,
                Jenkins
                """,
                attachLog: true,
                to: "bavishasundar@gmail.com",
                mimeType: 'text/html'
            )
        }

        failure {
            emailext (
                subject: "Jenkins Build Failed - JMeter Report",
                body: "Build failed. Please check Jenkins console output.",
                to: "bavishasundar@gmail.com"
            )
        }
    }
}
