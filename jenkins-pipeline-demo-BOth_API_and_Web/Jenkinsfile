pipeline {
    agent any

    environment {
        JMETER_HOME = 'C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                rmdir /s /q results 2>nul
                rmdir /s /q report 2>nul

                mkdir results
                mkdir report
                '''
            }
        }

        stage('Verify Files') {
            steps {
                bat '''
                echo ================= WEB FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\web

                echo ================= API FILE =================
                dir jenkins-pipeline-demo-BOth_API_and_Web\\api
                '''
            }
        }

        stage('Run WEB Test') {
            steps {
                bat """
                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\web\\SCR01_Jpetstore.jmx ^
                -l results\\web.jtl ^
                -e -o report\\web
                """
            }
        }

        stage('Run API Test') {
            steps {
                bat """
                %JMETER_HOME%\\bin\\jmeter.bat -n ^
                -t jenkins-pipeline-demo-BOth_API_and_Web\\api\\api_script.jmx ^
                -l results\\api.jtl ^
                -e -o report\\api
                """
            }
        }

        stage('Publish Aggregate Dashboard') {
            steps {
                perfReport(
                    sourceDataFiles: 'results/*.jtl',
                    errorFailedThreshold: 0,
                    errorUnstableThreshold: 0
                )
            }
        }

        stage('Publish HTML Reports') {
            steps {

                publishHTML([
                    reportDir: 'report/web',
                    reportFiles: 'index.html',
                    reportName: 'WEB HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true
                ])

                publishHTML([
                    reportDir: 'report/api',
                    reportFiles: 'index.html',
                    reportName: 'API HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true
                ])
            }
        }
    }

    post {

        always {
            archiveArtifacts artifacts: 'results/*.jtl', fingerprint: true
        }

        success {
            emailext(
                subject: "Jenkins Build SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                body: """
                <h2>JMeter Execution Successful</h2>

                <p>
                Aggregate dashboard is available in Jenkins UI under:
                <br><br>
                <b>Build → Performance Report</b>
                </p>
                """,

                mimeType: 'text/html',
                to: 'bavishasundar@gmail.com'
            )
        }

        failure {
            emailext(
                subject: "Jenkins Build FAILURE - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Build Failed. Check Console Output: ${env.BUILD_URL}console",
                to: 'bavishasundar@gmail.com'
            )
        }
    }
}
