pipeline {
    agent any

    environment {
        REPORT_DIR = "report"
        WEB_DIR = "report\\web"
        API_DIR = "report\\api"
        DASHBOARD_DIR = "report\\dashboard"
        ZIP_DIR = "report\\zips"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                bat 'if exist report rmdir /s /q report'
            }
        }

        stage('Create Directories') {
            steps {
                bat """
                if not exist report mkdir report
                if not exist report\\web mkdir report\\web
                if not exist report\\api mkdir report\\api
                if not exist report\\dashboard mkdir report\\dashboard
                if not exist report\\zips mkdir report\\zips
                """
            }
        }

        stage('Build Web Report') {
            steps {
                bat """
                echo Generating Web Report...
                echo Web Report Generated Successfully > report\\web\\web-report.html
                """
            }
        }

        stage('Build API Report') {
            steps {
                bat """
                echo Generating API Report...
                echo API Report Generated Successfully > report\\api\\api-report.html
                """
            }
        }

        stage('Create Dashboard') {
            steps {
                bat """
                echo ^<html^> > report\\dashboard\\index.html
                echo ^<head^>^<title^>Jenkins Dashboard^</title^>^</head^> >> report\\dashboard\\index.html
                echo ^<body^> >> report\\dashboard\\index.html
                echo ^<h1 style='color:blue;' ^>Test Dashboard^</h1^> >> report\\dashboard\\index.html
                echo ^<p^>✔ Web Report Generated^</p^> >> report\\dashboard\\index.html
                echo ^<p^>✔ API Report Generated^</p^> >> report\\dashboard\\index.html
                echo ^</body^> >> report\\dashboard\\index.html
                echo ^</html^> >> report\\dashboard\\index.html
                """
            }
        }

        stage('Zip Reports') {
            steps {
                bat """
                powershell Compress-Archive -Path report\\web\\* -DestinationPath report\\zips\\web.zip -Force
                powershell Compress-Archive -Path report\\api\\* -DestinationPath report\\zips\\api.zip -Force
                """
            }
        }
    }

    post {

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✅ Jenkins Build SUCCESS - Web & API Reports",
                mimeType: 'text/html',
                body: """
                <html>
                <body style="font-family: Arial;">

                    <h2 style="color:green;">🎉 Jenkins Build Successful</h2>

                    <h3>📊 Reports Generated</h3>
                    <ul>
                        <li>Web Report: report/web/web-report.html</li>
                        <li>API Report: report/api/api-report.html</li>
                        <li>Dashboard: report/dashboard/index.html</li>
                    </ul>

                    <h3>📦 ZIP Files</h3>
                    <ul>
                        <li>report/zips/web.zip</li>
                        <li>report/zips/api.zip</li>
                    </ul>

                    <p>✔ Build completed successfully in Jenkins workspace.</p>

                    <hr>
                    <p style="color:gray;">Regards,<br>Jenkins Pipeline</p>

                </body>
                </html>
                """
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins Build FAILED",
                mimeType: 'text/html',
                body: """
                <html>
                <body style="font-family: Arial;">

                    <h2 style="color:red;">Jenkins Build Failed</h2>

                    <p>Please check Jenkins console output for errors.</p>

                    <hr>
                    <p style="color:gray;">Regards,<br>Jenkins Pipeline</p>

                </body>
                </html>
                """
            )
        }

        always {
            archiveArtifacts artifacts: 'report/**', fingerprint: true
        }
    }
}
