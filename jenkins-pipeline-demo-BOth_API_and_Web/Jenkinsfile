pipeline {
    agent any

    environment {
        JMETER_HOME = "C:\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/bavishasundaram29-lang/jenkins-pipeline-demo-BOth_API_and_Web.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                bat '''
                if exist results rmdir /s /q results
                if exist report rmdir /s /q report

                mkdir results
                mkdir report
                mkdir report\\final
                '''
            }
        }

        stage('Run API + Web Parallel') {
            parallel {

                stage('API Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/api/api_script.jmx ^
                        -l results\\api.jtl
                        """
                    }
                }

                stage('Web Test') {
                    steps {
                        bat """
                        %JMETER_HOME%\\bin\\jmeter.bat -n ^
                        -t jenkins-pipeline-demo-BOth_API_and_Web/web/SCR01_Jpetstore.jmx ^
                        -l results\\web.jtl
                        """
                    }
                }
            }
        }

        stage('Generate Final Report') {
            steps {
                bat '''
                if exist report\\final rmdir /s /q report\\final

                %JMETER_HOME%\\bin\\jmeter.bat -g results\\api.jtl -o report\\final
                '''
            }
        }
    }

    post {

        always {
            archiveArtifacts artifacts: 'results/**, report/**', fingerprint: true

            publishHTML([
                allowMissing: false,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'report/final',
                reportFiles: 'index.html',
                reportName: 'JMeter Final Report'
            ])
        }

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✔ Jenkins SUCCESS - API + WEB",
                body: """
Build SUCCESS

✔ API executed
✔ Web executed

Report attached and available in Jenkins UI

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
""",
                attachmentsPattern: "report/final/**"
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins FAILED - API + WEB",
                body: """
Build FAILED

Check Jenkins console logs.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
            )
        }
    }
}
