pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Create Reports') {
            parallel {

                stage('Web Report') {
                    steps {
                        bat """
                        mkdir report\\web
                        (
                        echo ^<html^>
                        echo ^<body^>
                        echo ^<h2^>Web Report^</h2^>
                        echo ^<p^>Web report generated successfully^</p^>
                        echo ^</body^>
                        echo ^</html^>
                        ) > report\\web\\web-report.html
                        """
                    }
                }

                stage('API Report') {
                    steps {
                        bat """
                        mkdir report\\api
                        (
                        echo ^<html^>
                        echo ^<body^>
                        echo ^<h2^>API Report^</h2^>
                        echo ^<p^>API report generated successfully^</p^>
                        echo ^</body^>
                        echo ^</html^>
                        ) > report\\api\\api-report.html
                        """
                    }
                }
            }
        }

        stage('Dashboard') {
            steps {
                bat """
                mkdir report\\dashboard
                (
                echo ^<html^>
                echo ^<body^>
                echo ^<h2^>Dashboard^</h2^>
                echo ^<p^>All systems operational^</p^>
                echo ^</body^>
                echo ^</html^>
                ) > report\\dashboard\\index.html
                """
            }
        }

        stage('Aggregate Report') {
            steps {
                bat """
                mkdir report\\aggregate
                (
                echo ^<html^>
                echo ^<body^>
                echo ^<h2^>Aggregate Report^</h2^>
                echo ^<table border='1' cellpadding='8'^>
                echo ^<tr^>^<th^>Module^</th^>^<th^>Details^</th^>^</tr^>
                echo ^<tr^>^<td^>Web Report^</td^>^<td^>Web report generated successfully^</td^>^</tr^>
                echo ^<tr^>^<td^>API Report^</td^>^<td^>API report generated successfully^</td^>^</tr^>
                echo ^<tr^>^<td^>Dashboard^</td^>^<td^>All systems operational^</td^>^</tr^>
                echo ^</table^>
                echo ^</body^>
                echo ^</html^>
                ) > report\\aggregate\\aggregate.html
                """
            }
        }

        stage('Publish Reports to Jenkins UI') {
            steps {

                publishHTML([
                    reportDir: 'report/web',
                    reportFiles: 'web-report.html',
                    reportName: 'Web Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/api',
                    reportFiles: 'api-report.html',
                    reportName: 'API Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/dashboard',
                    reportFiles: 'index.html',
                    reportName: 'Dashboard',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                publishHTML([
                    reportDir: 'report/aggregate',
                    reportFiles: 'aggregate.html',
                    reportName: 'Aggregate Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])
            }
        }

        stage('Read Reports for Email') {
            steps {
                script {
                    env.WEB_REPORT = readFile('report/web/web-report.html')
                    env.API_REPORT = readFile('report/api/api-report.html')
                    env.DASHBOARD_REPORT = readFile('report/dashboard/index.html')
                }
            }
        }
    }

    post {

        success {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "✅ Jenkins Build SUCCESS - Full Reports",
                mimeType: "text/html",
                body: """
                <html>
                <body style="font-family: Arial;">

                <h2 style="color:green;">🎉 Build Successful</h2>

                <h3>📊 Web Report</h3>
                <pre>${WEB_REPORT}</pre>

                <h3>📊 API Report</h3>
                <pre>${API_REPORT}</pre>

                <h3>📊 Dashboard</h3>
                <pre>${DASHBOARD_REPORT}</pre>

                <hr>

                <h3>📦 Download Links</h3>
                <ul>
                    <li><a href="${BUILD_URL}artifact/report/web/web-report.html">Web Report</a></li>
                    <li><a href="${BUILD_URL}artifact/report/api/api-report.html">API Report</a></li>
                    <li><a href="${BUILD_URL}artifact/report/dashboard/index.html">Dashboard</a></li>
                    <li><a href="${BUILD_URL}artifact/report/aggregate/aggregate.html">Aggregate Report</a></li>
                    <li><a href="${BUILD_URL}artifact/">Download All Files</a></li>
                </ul>

                <p><b>Build:</b> ${JOB_NAME} #${BUILD_NUMBER}</p>

                </body>
                </html>
                """
            )
        }

        failure {
            emailext (
                to: "bavishasundar@gmail.com",
                subject: "❌ Jenkins Build FAILED",
                body: "Check logs: ${BUILD_URL}"
            )
        }
    }
}
\
